generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum GameSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum PuzzleStatus {
  ACTIVE
  SOLVED
  FAILED
  EXPIRED
  SKIPPED
}

enum Role {
  PLAYER
  ADMIN
}

// ==========================================
// USER
// ==========================================

model User {
  id           String  @id @default(cuid())
  displayName  String?
  email        String? @unique
  passwordHash String?

  // Email verification. Only one code is live at a time, so it sits on the
  // user row instead of its own table. The code itself is never stored, only its hash.
  emailVerifiedAt    DateTime?
  emailCodeHash      String?
  emailCodeExpiresAt DateTime?
  emailCodeSentAt    DateTime?
  emailCodeAttempts  Int       @default(0)

  isGuest      Boolean       @default(true)
  role         Role          @default(PLAYER)
  authSessions AuthSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameSessions   GameSession[]
  sessionPlayers SessionPlayer[]
  attempts       PuzzleAttempt[]

  @@index([createdAt])
}

// ==========================================
// GAME SESSION
// ==========================================

model GameSession {
  id     String            @id @default(cuid())
  userId String?
  status GameSessionStatus @default(ACTIVE)

  score         Int @default(0)
  totalPuzzles  Int @default(0)
  solvedPuzzles Int @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user    User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  puzzles Puzzle[]
  players SessionPlayer[]

  @@index([userId, startedAt])
  @@index([status, startedAt])
}

// ==========================================
// PUZZLE
// ==========================================

model Puzzle {
  id            String       @id @default(cuid())
  gameSessionId String
  questionUrl   String
  solution      Float
  status        PuzzleStatus @default(ACTIVE)

  maxAttempts  Int @default(10)
  attemptsUsed Int @default(0)

  expiresAt DateTime
  solvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameSession GameSession     @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  attempts    PuzzleAttempt[]

  @@index([gameSessionId, status])
  @@index([status, expiresAt])
}

// ==========================================
// PUZZLE ATTEMPT
// ==========================================

model PuzzleAttempt {
  id       String @id @default(cuid())
  puzzleId String

  answer        Float
  isCorrect     Boolean
  attemptNumber Int

  // who submitted it (null for attempts made before accounts existed)
  userId String?

  createdAt DateTime @default(now())

  puzzle Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([puzzleId, attemptNumber])
  @@index([puzzleId, createdAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==========================================
// SESSION PLAYER
// ==========================================

// Who is part of a game session, and their own score in it.
// GameSession.score stays the team total.
model SessionPlayer {
  id            String @id @default(cuid())
  gameSessionId String
  userId        String

  score       Int @default(0)
  solvedCount Int @default(0)

  joinedAt DateTime @default(now())

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // one row per player per session, the DB stops duplicates for us
  @@unique([gameSessionId, userId])
  @@index([userId])
}
